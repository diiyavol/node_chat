{
  "name": "node_chat",
  "version": "1.0.0",
  "description": "Chat using Node.js",
  "main": "src/index.js",
  "scripts": {
    "init": "mate-scripts init",
    "start": "node server/index.js && vite",
    "lint": "npm run format && mate-scripts lint",
    "format": "prettier --ignore-path .prettierignore --write './src/**/*.{js,jsx,ts,tsx}'",
    "test:only": "mate-scripts test",
    "update": "mate-scripts update",
    "postinstall": "npm run update",
    "test": "npm run lint && npm run test:only",
    "dev": "vite",
    "server": "node server/index.js",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\""
  },
  "author": "Mate academy",
  "license": "GPL-3.0",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.9",
    "@babel/preset-react": "^7.29.7",
    "@mate-academy/eslint-config": "latest",
    "@mate-academy/scripts": "^2.1.3",
    "concurrently": "^9.2.5",
    "eslint": "^8.57.0",
    "eslint-plugin-jest": "^28.6.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-react": "^7.37.5",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "vite": "^8.3.5"
  },
  "mateAcademy": {
    "projectType": "javascript"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "ws": "^8.22.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diiyavol/node_chat.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/diiyavol/node_chat/issues"
  },
  "homepage": "https://github.com/diiyavol/node_chat#readme"
}
